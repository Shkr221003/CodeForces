#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, x;
        cin >> n;

        int odd = 0, even = 0;
        long long sum = 0;

        while (n--) {
            cin >> x;
            sum += x;
            if (x & 1) odd++;
            else even++;
        }

        if (sum & 1 || (odd && even))
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
