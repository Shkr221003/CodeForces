#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, x, cnt = 0;
        cin >> n;

        while (n--) {
            cin >> x;
            if (x == 1) cnt++;
        }

        cout << (cnt % 2 ? "YES" : "NO") << '\n';
    }

    return 0;
}
