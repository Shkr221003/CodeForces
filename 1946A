
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        sort(a.begin(), a.end());

        int median = a[n / 2];
        int ans = 0;

        for (int i = n / 2; i < n; i++) {
            if (a[i] == median) {
                ans++;
            }
        }

        cout << ans << '\n';
    }

    return 0;
}
