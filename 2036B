#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        vector<int> brand(k + 1, 0);

        for (int i = 0; i < k; i++) {
            int b, c;
            cin >> b >> c;
            brand[b] += c;
        }

        sort(brand.rbegin(), brand.rend());

        long long ans = 0;

        for (int i = 0; i < min(n, k); i++) {
            ans += brand[i];
        }

        cout << ans << '\n';
    }

    return 0;
}
