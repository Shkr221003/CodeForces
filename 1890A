#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        map<int, int> mp;
        for (int i = 0, x; i < n; i++) {
            cin >> x;
            mp[x]++;
        }

        if (mp.size() == 1) {
            cout << "YES\n";
        } else if (mp.size() > 2) {
            cout << "NO\n";
        } else {
            auto it = mp.begin();
            int a = it->second;
            ++it;
            int b = it->second;

            cout << (abs(a - b) <= 1 ? "YES" : "NO") << '\n';
        }
    }

    return 0;
}
