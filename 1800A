#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        string s;

        cin >> n >> s;

        string x = "";

        for (char c : s) {
            c = tolower(c);

            if (x.empty() || x.back() != c) {
                x += c;
            }
        }

        if (x == "meow")
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
