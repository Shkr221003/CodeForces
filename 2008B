#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        string s;
        cin >> n >> s;

        int k = sqrt(n);

        if (k * k != n) {
            cout << "No\n";
            continue;
        }

        int ones = count(s.begin(), s.end(), '1');

        if (ones == 2 && s[0] == '1' && s[n - 1] == '1')
            cout << "Yes\n";
        else
            cout << "No\n";
    }

    return 0;
}
