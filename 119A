
#include <bits/stdc++.h>
using namespace std;

int main() {
    int a, b, n;
    cin >> a >> b >> n;

    while (true) {
        n -= gcd(a, n);

        if (n < 0) {
            cout << 1 << '\n';
            break;
        }

        n -= gcd(b, n);

        if (n < 0) {
            cout << 0 << '\n';
            break;
        }
    }

    return 0;
}
