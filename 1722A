#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    string timur = "Timur";
    sort(timur.begin(), timur.end());

    while (t--) {
        int n;
        string s;
        cin >> n >> s;

        sort(s.begin(), s.end());

        cout << (n == 5 && s == timur ? "YES" : "NO") << '\n';
    }

    return 0;
}
