#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int &x : a) cin >> x;

        sort(a.begin(), a.end());

        int ans = n - 1;

        // Remove from left
        for (int i = 0; i < n; i++) {
            if (a[i] % 2 == a[n - 1] % 2) {
                ans = min(ans, i);
                break;
            }
        }

        // Remove from right
        for (int i = n - 1; i >= 0; i--) {
            if (a[i] % 2 == a[0] % 2) {
                ans = min(ans, n - 1 - i);
                break;
            }
        }

        cout << ans << '\n';
    }

    return 0;
}
