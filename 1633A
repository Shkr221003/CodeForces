#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int base = (n / 10) * 10;

        for (int digit = 0; digit <= 9; digit++) {
            int x = base + digit;

            if (x % 7 == 0) {
                cout << x << '\n';
                break;
            }
        }
    }

    return 0;
}
