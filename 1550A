
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int s;
        cin >> s;

        int sum = 0, ans = 0;

        while (sum < s) {
            ans++;
            sum += ans;
        }

        cout << ans << '\n';
    }

    return 0;
}
