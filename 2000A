#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        if (s.size() < 3 || s.substr(0, 2) != "10" || s[2] == '0')
            cout << "NO\n";
        else {
            int x = stoi(s.substr(2));
            cout << (x >= 2 ? "YES" : "NO") << '\n';
        }
    }

    return 0;
}
