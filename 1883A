
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        int pos = 1, ans = 0;

        for (char c : s) {
            int d = (c == '0') ? 10 : c - '0';
            ans += abs(pos - d) + 1;
            pos = d;
        }

        cout << ans << '\n';
    }

    return 0;
}
