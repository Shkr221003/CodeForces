#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        string b;

        cin >> n;
        cin >> b;

        // Find distinct characters
        string r = "";

        for (char c : b) {
            if (r.find(c) == string::npos) {
                r += c;
            }
        }

        // Sort characters alphabetically
        sort(r.begin(), r.end());

        // Decode each character
        for (char c : b) {
            int pos = r.find(c);

            cout << r[r.size() - 1 - pos];
        }

        cout << '\n';
    }

    return 0;
}
