#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        string b;

        cin >> n >> b;

        // Find all distinct characters
        set<char> st(b);

        // Sorted distinct characters
        string r(st.begin(), st.end());

        // Create symmetric mapping
        map<char, char> mp;

        int m = r.size();

        for (int i = 0; i < m; i++) {
            mp[r[i]] = r[m - 1 - i];
        }

        // Decode
        for (char c : b) {
            cout << mp[c];
        }

        cout << '\n';
    }

    return 0;
}
