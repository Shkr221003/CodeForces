#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n, j, k;
        cin >> n >> j >> k;

        vector<int> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        // If we need only 1 player at the end,
        // player j must have maximum strength.
        if (k == 1) {
            int mx = *max_element(a.begin(), a.end());

            if (a[j - 1] == mx)
                cout << "YES\n";
            else
                cout << "NO\n";
        }
        else {
            // If k >= 2, we can always keep player j
            // among the last k players.
            cout << "YES\n";
        }
    }

    return 0;
}
