#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n), b;
        for (int &x : a) cin >> x;

        b.push_back(a[0]);

        for (int i = 1; i < n; i++) {
            if (a[i] < a[i - 1]) b.push_back(1);
            b.push_back(a[i]);
        }

        cout << b.size() << '\n';
        for (int x : b) cout << x << " ";
        cout << '\n';
    }

    return 0;
}
