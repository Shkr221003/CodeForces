#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        map<int,int> mp;

        for (int i = 0, x; i < n; i++) {
            cin >> x;
            mp[x]++;
        }

        int ans = 0;
        for (auto &p : mp)
            if (p.second == 2)
                ans++;

        cout << ans << '\n';
    }

    return 0;
}
