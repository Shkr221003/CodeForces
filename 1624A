#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int mn = 1e9, mx = 0, x;

        for (int i = 0; i < n; i++) {
            cin >> x;
            mn = min(mn, x);
            mx = max(mx, x);
        }

        cout << mx - mn << '\n';
    }

    return 0;
}
