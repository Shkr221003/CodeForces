#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        int h = stoi(s.substr(0, 2));
        string m = s.substr(3, 2);

        string ap = (h >= 12) ? "PM" : "AM";

        if (h == 0) h = 12;
        else if (h > 12) h -= 12;

        cout << setw(2) << setfill('0') << h << ":" << m << " " << ap << '\n';
    }

    return 0;
}
