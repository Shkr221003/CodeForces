#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        string s;

        cin >> n >> s;

        if (n >= 3)
            cout << "NO\n";
        else if (n == 1)
            cout << "YES\n";
        else
            cout << (s[0] != s[1] ? "YES\n" : "NO\n");
    }

    return 0;
}
