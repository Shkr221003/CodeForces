
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int k = sc.nextInt();

            long product = 1;

            for (int i = 0; i < n; i++) {
                int x = sc.nextInt();
                product *= x;
            }

            if (2023 % product != 0) {
                System.out.println("NO");
            } else {
                System.out.println("YES");

                System.out.print(2023 / product);

                for (int i = 1; i < k; i++) {
                    System.out.print(" 1");
                }

                System.out.println();
            }
        }

        sc.close();
    }
}
