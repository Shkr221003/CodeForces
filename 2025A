
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int q;
    cin >> q;

    while (q--) {
        string s, t;
        cin >> s >> t;

        int k = 0;
        while (k < (int)s.size() &&
               k < (int)t.size() &&
               s[k] == t[k]) {
            k++;
        }

        int ans = (int)s.size() + (int)t.size();

        if (k > 0)
            ans = (int)s.size() + (int)t.size() - k + 1;

        cout << ans << '\n';
    }

    return 0;
}
