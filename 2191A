
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        bool ok = true;

        for (int i = 1; i < n; i++) {
            if ((a[i] % 2) == (a[i - 1] % 2)) {
                // This check alone is not sufficient.
            }
        }

        vector<int> pos(n + 1);
        for (int i = 0; i < n; i++) {
            pos[a[i]] = i;
        }

        for (int x = 1; x < n; x++) {
            if ((pos[x] % 2) == (pos[x + 1] % 2)) {
                ok = false;
                break;
            }
        }

        cout << (ok ? "YES\n" : "NO\n");
    }

    return 0;
}
