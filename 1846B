
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        vector<string> a(3);

        for (int i = 0; i < 3; i++) {
            cin >> a[i];
        }

        char winner = 'D';

        // Check rows
        for (int i = 0; i < 3; i++) {
            if (a[i][0] != '.' &&
                a[i][0] == a[i][1] &&
                a[i][1] == a[i][2]) {
                winner = a[i][0];
            }
        }

        // Check columns
        for (int j = 0; j < 3; j++) {
            if (a[0][j] != '.' &&
                a[0][j] == a[1][j] &&
                a[1][j] == a[2][j]) {
                winner = a[0][j];
            }
        }

        // Check diagonals
        if (a[0][0] != '.' &&
            a[0][0] == a[1][1] &&
            a[1][1] == a[2][2]) {
            winner = a[0][0];
        }

        if (a[0][2] != '.' &&
            a[0][2] == a[1][1] &&
            a[1][1] == a[2][0]) {
            winner = a[0][2];
        }

        if (winner == 'D')
            cout << "DRAW\n";
        else
            cout << winner << '\n';
    }

    return 0;
}
