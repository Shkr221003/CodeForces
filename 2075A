
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            long n = sc.nextLong();
            long k = sc.nextLong();

            long ans;

            if (n % 2 == 1) {
                n -= k;

                ans = 1 + (n + (k - 1) - 1) / (k - 1);
            } else {
                ans = (n + (k - 1) - 1) / (k - 1);
            }

            System.out.println(ans);
        }

        sc.close();
    }
}
