#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        string a, b;
        cin >> a >> b;

        char ca = a.back();
        char cb = b.back();

        // Different base sizes: S < M < L
        if (ca != cb) {
            if (ca == 'S') {
                cout << "<\n";
            }
            else if (ca == 'M') {
                if (cb == 'S')
                    cout << ">\n";
                else
                    cout << "<\n";
            }
            else { // ca == 'L'
                cout << ">\n";
            }
        }
        else {
            // Both have the same base letter
            if (ca == 'M') {
                cout << "=\n";
            }
            else if (ca == 'S') {
                // More X means smaller
                if (a.length() < b.length())
                    cout << ">\n";
                else if (a.length() > b.length())
                    cout << "<\n";
                else
                    cout << "=\n";
            }
            else { // ca == 'L'
                // More X means larger
                if (a.length() < b.length())
                    cout << "<\n";
                else if (a.length() > b.length())
                    cout << ">\n";
                else
                    cout << "=\n";
            }
        }
    }

    return 0;
}
