#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        for (char a = 'a'; a <= 'z'; a++) {
            for (char b = 'a'; b <= 'z'; b++) {
                for (char c = 'a'; c <= 'z'; c++) {
                    if ((a - 'a' + 1) + (b - 'a' + 1) + (c - 'a' + 1) == n) {
                        cout << a << b << c << '\n';
                        goto done;
                    }
                }
            }
        }
        done:;
    }

    return 0;
}
