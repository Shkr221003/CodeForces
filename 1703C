#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int i = 0; i < n; i++)
            cin >> a[i];

        for (int i = 0; i < n; i++) {
            int m;
            string s;
            cin >> m >> s;

            for (char c : s) {
                if (c == 'U') {
                    a[i]--;
                    if (a[i] == -1)
                        a[i] = 9;
                } else { // 'D'
                    a[i]++;
                    if (a[i] == 10)
                        a[i] = 0;
                }
            }
        }

        for (int x : a)
            cout << x << " ";
        cout << "\n";
    }

    return 0;
}
