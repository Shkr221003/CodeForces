#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, x;
        cin >> n;

        long long even = 0, odd = 0;

        while (n--) {
            cin >> x;
            if (x % 2 == 0) even += x;
            else odd += x;
        }

        cout << (even > odd ? "YES" : "NO") << '\n';
    }

    return 0;
}
