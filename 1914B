#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        // Increasing part: exactly k increases
        for (int i = n - k; i <= n; i++) {
            cout << i << " ";
        }

        // Decreasing part: no more increases
        for (int i = n - k - 1; i >= 1; i--) {
            cout << i << " ";
        }

        cout << '\n';
    }

    return 0;
}
