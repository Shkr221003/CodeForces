#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        set<int> seen;
        int answer = 0;

        // Start from the right because we want
        // the longest suffix with all distinct values.
        for (int i = n - 1; i >= 0; i--) {

            if (seen.count(a[i])) {
                answer = i + 1;
                break;
            }

            seen.insert(a[i]);
        }

        cout << answer << '\n';
    }

    return 0;
}
