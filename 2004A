#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> x(n);

        for (int i = 0; i < n; i++) {
            cin >> x[i];
        }

        bool possible = false;

        for (int i = 1; i < n; i++) {
            if (x[i] - x[i - 1] > 1) {
                possible = true;
                break;
            }
        }

        if (possible)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
