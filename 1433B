#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int &x : a) cin >> x;

        int first = 0, last = n - 1;

        while (a[first] == 0) first++;
        while (a[last] == 0) last--;

        int ans = 0;

        for (int i = first; i <= last; i++) {
            if (a[i] == 0)
                ans++;
        }

        cout << ans << '\n';
    }

    return 0;
}
