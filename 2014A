#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        long long coins = 0;
        int ans = 0;

        while (n--) {
            int x;
            cin >> x;

            if (x > 0) coins += x;
            else if (coins >= k) {
                coins--;
                ans++;
            }
        }

        cout << ans << '\n';
    }

    return 0;
}
