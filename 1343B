#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        if ((n / 2) % 2) {
            cout << "NO\n";
            continue;
        }

        cout << "YES\n";

        int sumE = 0, sumO = 0;

        for (int i = 1; i <= n / 2; i++) {
            cout << 2 * i << " ";
            sumE += 2 * i;
        }

        for (int i = 1; i < n / 2; i++) {
            cout << 2 * i - 1 << " ";
            sumO += 2 * i - 1;
        }

        cout << sumE - sumO << '\n';
    }

    return 0;
}
