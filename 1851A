#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n, m, k, H;
        cin >> n >> m >> k >> H;

        int ans = 0;

        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;

            int diff = abs(H - x);

            if (diff > 0 &&
                diff % k == 0 &&
                diff <= (m - 1) * k) {
                ans++;
            }
        }

        cout << ans << '\n';
    }

    return 0;
}
