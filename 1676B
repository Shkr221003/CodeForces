#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int &x : a) cin >> x;

        int mn = *min_element(a.begin(), a.end());

        long long ans = 0;
        for (int x : a) ans += x - mn;

        cout << ans << '\n';
    }

    return 0;
}
