#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        long long w, h, n;
        cin >> w >> h >> n;

        long long pieces = 1;

        while (w % 2 == 0) {
            pieces *= 2;
            w /= 2;
        }

        while (h % 2 == 0) {
            pieces *= 2;
            h /= 2;
        }

        cout << (pieces >= n ? "YES" : "NO") << '\n';
    }

    return 0;
}
