#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int &x : a) cin >> x;

        bool sorted = true;
        int mn = 1e9;

        for (int i = 0; i < n - 1; i++) {
            if (a[i] > a[i + 1]) sorted = false;
            mn = min(mn, a[i + 1] - a[i]);
        }

        if (!sorted) cout << 0 << '\n';
        else cout << mn / 2 + 1 << '\n';
    }

    return 0;
}
