#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        string s;
        cin >> s;

        string ans;

        for (int i = n - 1; i >= 0; ) {
            int num;

            if (s[i] == '0') {
                num = (s[i - 2] - '0') * 10
                    + (s[i - 1] - '0');
                i -= 3;
            } else {
                num = s[i] - '0';
                i--;
            }

            ans += char('a' + num - 1);
        }

        reverse(ans.begin(), ans.end());

        cout << ans << '\n';
    }

    return 0;
}
