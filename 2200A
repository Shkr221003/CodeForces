#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);

        for (int &x : a)
            cin >> x;

        int mx = *max_element(a.begin(), a.end());

        int ans = 0;
        for (int x : a) {
            if (x == mx)
                ans++;
        }

        cout << ans << '\n';
    }

    return 0;
}
