#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int i = 0; i < n; i++)
            cin >> a[i];

        set<int> occupied;
        occupied.insert(a[0]);

        bool ok = true;

        for (int i = 1; i < n; i++) {
            int seat = a[i];

            if (occupied.count(seat - 1) || occupied.count(seat + 1)) {
                occupied.insert(seat);
            } else {
                ok = false;
                break;
            }
        }

        cout << (ok ? "YES" : "NO") << '\n';
    }

    return 0;
}
