
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();

            int[] arr = new int[n];
            int min = Integer.MAX_VALUE;

            for (int i = 0; i < n; i++) {
                arr[i] = sc.nextInt();
                min = Math.min(min, arr[i]);
            }

            boolean possible = true;

            if (min % 2 == 0) {
                for (int i = 0; i < n; i++) {
                    if (arr[i] % 2 != 0) {
                        possible = false;
                        break;
                    }
                }
            }

            System.out.println(possible ? "YES" : "NO");
        }

        sc.close();
    }
}
