#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int a, b, c;
        cin >> a >> b >> c;

        int x = a - 1;
        int y = abs(b - c) + c - 1;

        if (x < y) cout << 1;
        else if (x > y) cout << 2;
        else cout << 3;

        cout << '\n';
    }

    return 0;
}
