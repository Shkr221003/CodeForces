#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int &x : a) cin >> x;

        int ans = 0;

        for (int j = 1; j < n; j++) {
            for (int i = 0; i < j; i++) {
                if (a[i] > a[j]) {
                    ans++;
                    break;
                }
            }
        }

        cout << ans << '\n';
    }

    return 0;
}
