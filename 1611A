#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        // Already even
        if ((s.back() - '0') % 2 == 0) {
            cout << 0 << '\n';
        }
        // First digit is even -> reverse the whole prefix
        else if ((s[0] - '0') % 2 == 0) {
            cout << 1 << '\n';
        }
        // Some middle digit is even
        else {
            bool found = false;

            for (int i = 1; i < (int)s.size() - 1; i++) {
                if ((s[i] - '0') % 2 == 0) {
                    found = true;
                    break;
                }
            }

            if (found)
                cout << 2 << '\n';
            else
                cout << -1 << '\n';
        }
    }

    return 0;
}
