#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<int> a(n);

    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    int minDiff = INT_MAX;
    int ans1 = 1, ans2 = 2;

    // Check normal neighbouring pairs
    for (int i = 0; i < n - 1; i++) {
        int diff = abs(a[i] - a[i + 1]);

        if (diff < minDiff) {
            minDiff = diff;
            ans1 = i + 1;
            ans2 = i + 2;
        }
    }

    // Check last and first because soldiers stand in a circle
    int diff = abs(a[n - 1] - a[0]);

    if (diff < minDiff) {
        ans1 = n;
        ans2 = 1;
    }

    cout << ans1 << " " << ans2 << '\n';

    return 0;
}
