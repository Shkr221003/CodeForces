#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int a = n / 3;
        int r = n % 3;

        int h1, h2, h3;

        if (r == 0) {
            h1 = a + 1;
            h2 = a;
            h3 = a - 1;
        }
        else if (r == 1) {
            h1 = a + 1;
            h2 = a;
            h3 = a - 1;
        }
        else {
            h1 = a + 2;
            h2 = a + 1;
            h3 = a - 1;
        }

        cout << h2 << " " << h1 << " " << h3 << '\n';
    }

    return 0;
}
