#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, x, xr = 0;
        cin >> n;

        while (n--) {
            cin >> x;
            xr ^= x;
        }

        if (n % 2 == 0)
            cout << (xr ? -1 : 0) << '\n';
        else
            cout << xr << '\n';
    }

    return 0;
}
