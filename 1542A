#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, x, odd = 0;
        cin >> n;

        for (int i = 0; i < 2 * n; i++) {
            cin >> x;
            if (x & 1) odd++;
        }

        cout << (odd == n ? "Yes" : "No") << '\n';
    }

    return 0;
}
