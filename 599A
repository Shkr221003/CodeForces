#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    long long d1, d2, d3;
    cin >> d1 >> d2 >> d3;

    long long ans = min({
        2 * (d1 + d2),
        2 * (d1 + d3),
        2 * (d2 + d3),
        d1 + d2 + d3
    });

    cout << ans << '\n';

    return 0;
}
