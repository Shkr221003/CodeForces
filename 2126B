#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        int ans = 0;
        int cnt = 0;

        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;

            if (x == 0) {
                cnt++;
            } else {
                ans += (cnt + 1) / (k + 1);
                cnt = 0;
            }
        }

        ans += (cnt + 1) / (k + 1);

        cout << ans << '\n';
    }

    return 0;
}
