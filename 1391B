#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n, m;
        cin >> n >> m;

        vector<string> a(n);

        for (auto &s : a)
            cin >> s;

        int ans = 0;

        // Last row must be all R
        for (int j = 0; j < m - 1; j++) {
            if (a[n - 1][j] != 'R')
                ans++;
        }

        // Last column must be all D
        for (int i = 0; i < n - 1; i++) {
            if (a[i][m - 1] != 'D')
                ans++;
        }

        cout << ans << '\n';
    }

    return 0;
}
