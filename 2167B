#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        map<int,int> mp;
        bool ok = false;

        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;
            mp[x]++;
            if (mp[x] >= 2) ok = true;
        }

        cout << (ok ? "YES" : "NO") << '\n';
    }

    return 0;
}
