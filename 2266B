
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            long a = sc.nextLong();
            long b = sc.nextLong();
            long c = sc.nextLong();

            long ans = Math.max(Math.abs(a - b), a + c - b);

            System.out.println(ans);
        }

        sc.close();
    }
}
