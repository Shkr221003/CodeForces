#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        long long n;
        cin >> n;

        set<long long> s;

        // Perfect squares
        for (long long i = 1; i * i <= n; i++) {
            s.insert(i * i);
        }

        // Perfect cubes
        for (long long i = 1; i * i * i <= n; i++) {
            s.insert(i * i * i);
        }

        cout << s.size() << '\n';
    }

    return 0;
}
