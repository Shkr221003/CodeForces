#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        long long n, k;
        cin >> n >> k;

        // Sum of numbers from (n-k+1) to n
        long long total = n * (n + 1) / 2;
        long long before = (n - k) * (n - k + 1) / 2;

        long long sum = total - before;

        if (sum % 2 == 0)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
