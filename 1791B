#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        string s;
        cin >> n >> s;

        int x = 0, y = 0;
        bool ok = false;

        for (char c : s) {
            if (c == 'U') y++;
            else if (c == 'D') y--;
            else if (c == 'L') x--;
            else x++;

            if (x == 1 && y == 1)
                ok = true;
        }

        cout << (ok ? "YES" : "NO") << '\n';
    }

    return 0;
}
