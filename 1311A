#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int a, b;
        cin >> a >> b;

        if (a == b) cout << 0;
        else if (a < b)
            cout << ((b - a) % 2 ? 1 : 2);
        else
            cout << ((a - b) % 2 ? 2 : 1);

        cout << '\n';
    }

    return 0;
}
