#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        long long sum = 0;
        int operations = 0;
        bool negative = false;

        for (int i = 0; i < n; i++) {
            long long x;
            cin >> x;

            sum += abs(x);

            if (x < 0) {
                if (!negative) {
                    operations++;
                    negative = true;
                }
            } else if (x > 0) {
                negative = false;
            }
        }

        cout << sum << " " << operations << '\n';
    }

    return 0;
}
