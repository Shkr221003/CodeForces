#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        int cnt[26] = {};

        for (char c : s)
            cnt[c - 'a']++;

        int twice = 0, once = 0;

        for (int i = 0; i < 26; i++) {
            if (cnt[i] >= 2)
                twice++;
            else if (cnt[i] == 1)
                once++;
        }

        cout << twice + once / 2 << '\n';
    }

    return 0;
}
