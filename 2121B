#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        string s;

        cin >> n >> s;

        int freq[26] = {};

        // Count frequency of every character
        for (char c : s) {
            freq[c - 'a']++;
        }

        bool ok = false;

        // Only middle characters can be chosen as b
        for (int i = 1; i < n - 1; i++) {
            if (freq[s[i] - 'a'] >= 2) {
                ok = true;
                break;
            }
        }

        cout << (ok ? "Yes" : "No") << '\n';
    }

    return 0;
}
