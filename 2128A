
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        long long c;
        cin >> n >> c;

        vector<long long> a(n);
        for (auto &x : a) cin >> x;

        sort(a.rbegin(), a.rend());

        int coins = 0;

        for (int i = 0; i < n; i++) {
            if (a[i] <= c / (1LL << i)) {
                continue;
            }
            coins++;
        }

        cout << coins << '\n';
    }

    return 0;
}
