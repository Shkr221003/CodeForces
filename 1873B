#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<long long> a(n);
        for (auto &x : a) cin >> x;

        int p = min_element(a.begin(), a.end()) - a.begin();
        a[p]++;

        long long ans = 1;
        for (auto x : a) ans *= x;

        cout << ans << '\n';
    }

    return 0;
}
