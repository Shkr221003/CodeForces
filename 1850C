#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        vector<string> g(8);

        for (int i = 0; i < 8; i++)
            cin >> g[i];

        string ans = "";

        for (int i = 0; i < 8; i++) {
            for (int j = 0; j < 8; j++) {
                if (g[i][j] != '.')
                    ans += g[i][j];
            }
        }

        cout << ans << '\n';
    }

    return 0;
}
