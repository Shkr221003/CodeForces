#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    string a, b;
    cin >> a >> b;

    int ans = 0;

    for (int i = 0; i < n; i++) {
        int x = a[i] - '0';
        int y = b[i] - '0';

        int diff = abs(x - y);

        // Two possible ways:
        // direct distance = diff
        // wrap-around distance = 10 - diff
        ans += min(diff, 10 - diff);
    }

    cout << ans << '\n';

    return 0;
}
