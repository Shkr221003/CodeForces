#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int zero = 0;
        long long product = 1;

        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;

            if (x == 0)
                zero++;
            product *= x;
        }

        if (zero >= 2)
            cout << 0 << '\n';
        else if (zero == 1)
            cout << 1 << '\n';
        else {
            if (product == 1)
                cout << 2 << '\n';
            else
                cout << 1 << '\n';
        }
    }

    return 0;
}
