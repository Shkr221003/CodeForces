#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    vector<long long> v;

    for (int d = 1; d <= 9; d++) {
        long long x = 0;
        for (int len = 1; len <= 9; len++) {
            x = x * 10 + d;
            v.push_back(x);
        }
    }

    sort(v.begin(), v.end());

    while (t--) {
        long long n;
        cin >> n;
        cout << upper_bound(v.begin(), v.end(), n) - v.begin() << '\n';
    }

    return 0;
}
