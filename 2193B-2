#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int &x : a)
            cin >> x;

        int l = 0;

        // Find first position that is not n, n-1, n-2...
        while (l < n && a[l] == n - l)
            l++;

        if (l < n) {
            int r = l;

            // Find n-l
            while (a[r] != n - l)
                r++;

            reverse(a.begin() + l, a.begin() + r + 1);
        }

        for (int x : a)
            cout << x << ' ';

        cout << '\n';
    }

    return 0;
}
