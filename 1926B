#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<string> grid(n);

        for (int i = 0; i < n; i++) {
            cin >> grid[i];
        }

        int first = -1, second = -1;

        for (int i = 0; i < n; i++) {
            int cnt = 0;

            for (char c : grid[i]) {
                if (c == '1')
                    cnt++;
            }

            if (cnt > 0) {
                if (first == -1)
                    first = cnt;
                else {
                    second = cnt;
                    break;
                }
            }
        }

        if (first == second)
            cout << "SQUARE\n";
        else
            cout << "TRIANGLE\n";
    }

    return 0;
}
