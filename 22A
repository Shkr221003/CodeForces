
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        Arrays.sort(arr);

        boolean found = false;

        for (int i = 1; i < n; i++) {
            if (arr[i] > arr[0]) {
                System.out.println(arr[i]);
                found = true;
                break;
            }
        }

        if (!found) {
            System.out.println("NO");
        }

        sc.close();
    }
}
