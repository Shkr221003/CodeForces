#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        int a = s[0] - 'a';
        int b = s[1] - 'a';

        int ans = a * 25 + b + 1;

        if (b > a)
            ans--;

        cout << ans << '\n';
    }

    return 0;
}
