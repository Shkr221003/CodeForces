
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();

            int[] freq = new int[n + 1];

            int maxFreq = 0;

            for (int i = 0; i < n; i++) {
                int x = sc.nextInt();

                freq[x]++;

                maxFreq = Math.max(maxFreq, freq[x]);
            }

            System.out.println(maxFreq);
        }

        sc.close();
    }
}
