#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        string keyboard, word;
        cin >> keyboard >> word;

        vector<int> pos(26);

        for (int i = 0; i < 26; i++)
            pos[keyboard[i] - 'a'] = i;

        int ans = 0;

        for (int i = 1; i < word.size(); i++) {
            ans += abs(pos[word[i] - 'a'] - pos[word[i - 1] - 'a']);
        }

        cout << ans << '\n';
    }

    return 0;
}
