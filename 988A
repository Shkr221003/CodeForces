
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, k;
    cin >> n >> k;

    set<int> seen;
    vector<int> ans;

    for (int i = 1; i <= n; i++) {
        int x;
        cin >> x;

        if (seen.insert(x).second) {
            ans.push_back(i);
        }
    }

    if ((int)ans.size() < k) {
        cout << "NO\n";
    } else {
        cout << "YES\n";
        for (int i = 0; i < k; i++) {
            cout << ans[i] << (i + 1 == k ? '\n' : ' ');
        }
    }

    return 0;
}
