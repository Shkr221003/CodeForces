#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        long long sum = 0;
        bool has1 = false;
        bool has2 = false;

        for (int i = 0; i < n; i++) {
            long long x;
            cin >> x;

            sum += x;

            if (x % 3 == 1)
                has1 = true;

            if (x % 3 == 2)
                has2 = true;
        }

        int rem = sum % 3;

        if (rem == 0) {
            cout << 0 << '\n';
        }
        else if (rem == 1) {
            if (has1)
                cout << 1 << '\n';
            else
                cout << 2 << '\n';
        }
        else { // rem == 2
            cout << 1 << '\n';
        }
    }

    return 0;
}
