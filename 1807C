#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        string s;

        cin >> n >> s;

        // position of each character:
        // 0 = not seen
        // 1 = seen at even positions
        // 2 = seen at odd positions
        int pos[26] = {0};

        bool ok = true;

        for (int i = 0; i < n; i++) {
            int c = s[i] - 'a';

            int type = (i % 2 == 0) ? 1 : 2;

            if (pos[c] == 0) {
                pos[c] = type;
            }
            else if (pos[c] != type) {
                ok = false;
                break;
            }
        }

        cout << (ok ? "YES" : "NO") << '\n';
    }

    return 0;
}
