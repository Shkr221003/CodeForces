#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int r, c;
    cin >> r >> c;

    vector<string> cake(r);

    for (int i = 0; i < r; i++) {
        cin >> cake[i];
    }

    int cleanRows = 0;
    int cleanCols = 0;

    // Count rows without strawberries
    for (int i = 0; i < r; i++) {
        bool clean = true;

        for (int j = 0; j < c; j++) {
            if (cake[i][j] == 'S') {
                clean = false;
                break;
            }
        }

        if (clean)
            cleanRows++;
    }

    // Count columns without strawberries
    for (int j = 0; j < c; j++) {
        bool clean = true;

        for (int i = 0; i < r; i++) {
            if (cake[i][j] == 'S') {
                clean = false;
                break;
            }
        }

        if (clean)
            cleanCols++;
    }

    int answer = cleanRows * c + cleanCols * (r - cleanRows);

    cout << answer << '\n';

    return 0;
}
