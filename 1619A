#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        int n = s.size();

        if (n % 2) {
            cout << "NO\n";
            continue;
        }

        cout << (s.substr(0, n / 2) == s.substr(n / 2) ? "YES" : "NO") << '\n';
    }

    return 0;
}
