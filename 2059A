
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        set<int> a, b;
        int x;

        for (int i = 0; i < n; i++) {
            cin >> x;
            a.insert(x);
        }

        for (int i = 0; i < n; i++) {
            cin >> x;
            b.insert(x);
        }

        if (a.size() + b.size() >= 4)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
