#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);

        for (int &x : a)
            cin >> x;

        // Try every element as x
        for (int i = 0; i < n; i++) {
            int xr = 0;

            for (int j = 0; j < n; j++) {
                if (i != j)
                    xr ^= a[j];
            }

            if (xr == a[i]) {
                cout << a[i] << '\n';
                break;
            }
        }
    }

    return 0;
}
