#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        string s;
        cin >> s;

        string ans = "";

        int i = 0;

        while (i < n) {
            ans += s[i];

            int j = i + 1;
            while (j < n && s[j] != s[i])
                j++;

            i = j + 1;
        }

        cout << ans << '\n';
    }

    return 0;
}
