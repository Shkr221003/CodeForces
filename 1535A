#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int a, b, c, d;
        cin >> a >> b >> c >> d;

        int w1 = max(a, b);
        int w2 = max(c, d);

        vector<int> v = {a, b, c, d};
        sort(v.begin(), v.end());

        cout << ((min(w1, w2) == v[2] && max(w1, w2) == v[3]) ? "YES" : "NO") << '\n';
    }

    return 0;
}
