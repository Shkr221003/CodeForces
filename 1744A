
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int &x : a) {
            cin >> x;
        }

        string s;
        cin >> s;

        vector<char> mp(51, 0);
        bool ok = true;

        for (int i = 0; i < n; i++) {
            if (mp[a[i]] == 0) {
                mp[a[i]] = s[i];
            } else if (mp[a[i]] != s[i]) {
                ok = false;
                break;
            }
        }

        cout << (ok ? "YES\n" : "NO\n");
    }

    return 0;
}
