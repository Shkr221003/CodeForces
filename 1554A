#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        long long prev, x;
        cin >> prev;

        long long ans = 0;

        for (int i = 1; i < n; i++) {
            cin >> x;

            ans = max(ans, prev * x);

            prev = x;
        }

        cout << ans << '\n';
    }

    return 0;
}
