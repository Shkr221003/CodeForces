#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        // Smallest n numbers
        int low = 1;

        // Large numbers
        int high = n + 1;

        for (int i = 0; i < n; i++) {
            cout << low++ << ' ';
            cout << high++ << ' ';
            cout << high++ << ' ';
        }

        cout << '\n';
    }

    return 0;
}
