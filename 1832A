
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        set<char> st;

        for (int i = 0; i < (int)s.size() / 2; i++) {
            st.insert(s[i]);
        }

        cout << (st.size() > 1 ? "YES" : "NO") << '\n';
    }

    return 0;
}
