#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<vector<string>> a(3, vector<string>(n));
        map<string, int> freq;

        // Input and frequency count
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < n; j++) {
                cin >> a[i][j];
                freq[a[i][j]]++;
            }
        }

        // Calculate score for each player
        for (int i = 0; i < 3; i++) {
            int score = 0;

            for (int j = 0; j < n; j++) {
                if (freq[a[i][j]] == 1)
                    score += 3;
                else if (freq[a[i][j]] == 2)
                    score += 1;
            }

            cout << score << " ";
        }

        cout << '\n';
    }

    return 0;
}
