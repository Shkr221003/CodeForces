
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        string s;
        cin >> s;

        set<char> st;
        int ans = 1;

        for (char c : s) {
            if (!st.count(c) && st.size() == 3) {
                ans++;
                st.clear();
            }
            st.insert(c);
        }

        cout << ans << '\n';
    }

    return 0;
}
