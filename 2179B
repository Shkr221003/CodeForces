
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int &x : a) cin >> x;

        int total = 0;
        for (int i = 1; i < n; i++) {
            total += abs(a[i] - a[i - 1]);
        }

        int maxSave = max(abs(a[1] - a[0]),
                          abs(a[n - 1] - a[n - 2]));

        for (int i = 1; i < n - 1; i++) {
            int save = abs(a[i] - a[i - 1])
                     + abs(a[i + 1] - a[i])
                     - abs(a[i + 1] - a[i - 1]);

            maxSave = max(maxSave, save);
        }

        cout << total - maxSave << '\n';
    }

    return 0;
}
