
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<int> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    vector<int> ans;

    for (int i = 1; i < n; i++) {
        if (a[i] == 1) {
            ans.push_back(a[i - 1]);
        }
    }

    ans.push_back(a[n - 1]);

    cout << ans.size() << '\n';

    for (int x : ans) {
        cout << x << " ";
    }

    cout << '\n';

    return 0;
}
