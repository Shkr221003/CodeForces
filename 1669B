#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        map<int,int> mp;
        int ans = -1;

        for (int i = 0, x; i < n; i++) {
            cin >> x;
            mp[x]++;
            if (mp[x] >= 3) ans = x;
        }

        cout << ans << '\n';
    }

    return 0;
}
