#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        string s, f;

        cin >> n;
        cin >> s;
        cin >> f;

        int remove = 0;
        int add = 0;

        for (int i = 0; i < n; i++) {
            if (s[i] == '1' && f[i] == '0') {
                remove++;
            }
            else if (s[i] == '0' && f[i] == '1') {
                add++;
            }
        }

        cout << max(remove, add) << '\n';
    }

    return 0;
}
