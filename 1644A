
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            String s = sc.next();

            boolean r = false;
            boolean g = false;
            boolean b = false;

            boolean possible = true;

            for (int i = 0; i < s.length(); i++) {
                char ch = s.charAt(i);

                if (ch == 'r') {
                    r = true;
                } else if (ch == 'g') {
                    g = true;
                } else if (ch == 'b') {
                    b = true;
                } else if (ch == 'R' && !r) {
                    possible = false;
                } else if (ch == 'G' && !g) {
                    possible = false;
                } else if (ch == 'B' && !b) {
                    possible = false;
                }
            }

            System.out.println(possible ? "YES" : "NO");
        }

        sc.close();
    }
}
