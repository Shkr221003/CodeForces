#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);

        for (int i = 0; i < n; i++)
            a[i] = i + 1;

        // Swap adjacent pairs
        for (int i = 0; i + 1 < n; i += 2)
            swap(a[i], a[i + 1]);

        // If n is odd, fix the last 3 elements
        if (n % 2 == 1)
            swap(a[n - 2], a[n - 1]);

        for (int x : a)
            cout << x << ' ';

        cout << '\n';
    }

    return 0;
}
