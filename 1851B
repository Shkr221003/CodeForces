#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n), b;

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        b = a;
        sort(b.begin(), b.end());

        bool possible = true;

        for (int i = 0; i < n; i++) {
            if (a[i] % 2 != b[i] % 2) {
                possible = false;
                break;
            }
        }

        cout << (possible ? "YES" : "NO") << '\n';
    }

    return 0;
}
