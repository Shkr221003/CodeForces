#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        for (int &x : a) cin >> x;

        int even = a[0] % 2;
        int odd = a[1] % 2;
        bool ok = true;

        for (int i = 0; i < n; i++) {
            if (i % 2 == 0 && a[i] % 2 != even) ok = false;
            if (i % 2 == 1 && a[i] % 2 != odd) ok = false;
        }

        cout << (ok ? "YES" : "NO") << '\n';
    }

    return 0;
}
