#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int e = 0, o = 0;

        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;

            if (i % 2 != x % 2) {
                if (i % 2 == 0) e++;
                else o++;
            }
        }

        cout << (e == o ? e : -1) << '\n';
    }

    return 0;
}
