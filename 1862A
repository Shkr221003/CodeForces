#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n, m;
        cin >> n >> m;

        vector<string> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        string target = "vika";
        int pos = 0;

        for (int col = 0; col < m && pos < 4; col++) {

            for (int row = 0; row < n; row++) {
                if (a[row][col] == target[pos]) {
                    pos++;
                    break;
                }
            }
        }

        if (pos == 4)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
