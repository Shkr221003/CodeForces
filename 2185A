#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        long long a, b, c;
        cin >> a >> b >> c;

        long long ans = 0;

        for (int i = 0; i <= 5; i++)
            for (int j = 0; j <= 5 - i; j++) {
                int k = 5 - i - j;
                ans = max(ans, (a + i) * (b + j) * (c + k));
            }

        cout << ans << '\n';
    }

    return 0;
}
