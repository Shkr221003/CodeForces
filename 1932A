#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        string s;

        cin >> n;
        cin >> s;

        int ans = 0;

        for (int i = 0; i < n; i++) {
            // Two consecutive thorns -> cannot move further
            if (i > 0 && s[i] == '*' && s[i - 1] == '*') {
                break;
            }

            if (s[i] == '@') {
                ans++;
            }
        }

        cout << ans << '\n';
    }

    return 0;
}
