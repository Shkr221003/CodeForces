
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            String s1 = sc.next();
            String s2 = sc.next();

            String s = s1 + s2;

            int[] freq = new int[26];

            int distinct = 0;

            for (int i = 0; i < s.length(); i++) {
                int index = s.charAt(i) - 'a';

                if (freq[index] == 0) {
                    distinct++;
                }

                freq[index]++;
            }

            System.out.println(distinct - 1);
        }

        sc.close();
    }
}
