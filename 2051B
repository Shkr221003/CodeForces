#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        long long n, a, b, c;
        cin >> n >> a >> b >> c;

        long long sum = a + b + c;
        long long ans = (n / sum) * 3;
        long long rem = n % sum;

        if (rem == 0)
            cout << ans << '\n';
        else if (rem <= a)
            cout << ans + 1 << '\n';
        else if (rem <= a + b)
            cout << ans + 2 << '\n';
        else
            cout << ans + 3 << '\n';
    }

    return 0;
}
