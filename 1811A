#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n, d;
        cin >> n >> d;

        string s;
        cin >> s;

        char digit = char('0' + d);

        bool inserted = false;

        for (int i = 0; i < n; i++) {
            if (!inserted && digit > s[i]) {
                cout << digit;
                inserted = true;
            }

            cout << s[i];
        }

        if (!inserted) {
            cout << digit;
        }

        cout << '\n';
    }

    return 0;
}
