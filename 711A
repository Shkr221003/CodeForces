#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<string> a(n);
    bool found = false;

    for (int i = 0; i < n; i++) {
        cin >> a[i];

        if (!found) {
            if (a[i][0] == 'O' && a[i][1] == 'O') {
                a[i][0] = a[i][1] = '+';
                found = true;
            }
            else if (a[i][3] == 'O' && a[i][4] == 'O') {
                a[i][3] = a[i][4] = '+';
                found = true;
            }
        }
    }

    if (!found) {
        cout << "NO\n";
    } else {
        cout << "YES\n";
        for (string s : a)
            cout << s << '\n';
    }

    return 0;
}
