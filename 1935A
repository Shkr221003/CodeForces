#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        long long n;
        string s;
        cin >> n >> s;

        string r = s;
        reverse(r.begin(), r.end());

        cout << min(s, r + s) << '\n';
    }

    return 0;
}
