#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        long long x;
        cin >> n >> x;

        vector<long long> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        sort(a.rbegin(), a.rend());

        int teams = 0;
        long long members = 0;

        for (int i = 0; i < n; i++) {
            members++;

            // a[i] is the minimum skill of current team
            if (members * a[i] >= x) {
                teams++;
                members = 0;
            }
        }

        cout << teams << '\n';
    }

    return 0;
}
