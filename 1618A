#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        long long b[7];

        for (int i = 0; i < 7; i++) {
            cin >> b[i];
        }

        long long a1 = b[0];
        long long a2 = b[1];
        long long a3 = b[6] - a1 - a2;

        cout << a1 << " " << a2 << " " << a3 << '\n';
    }

    return 0;
}
