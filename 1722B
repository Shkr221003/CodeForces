#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        string a, b;
        cin >> n >> a >> b;

        for (char &c : a)
            if (c == 'G') c = 'B';

        for (char &c : b)
            if (c == 'G') c = 'B';

        cout << (a == b ? "YES" : "NO") << '\n';
    }

    return 0;
}
