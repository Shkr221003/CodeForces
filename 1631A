#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n), b(n);

        for (int &x : a) cin >> x;
        for (int &x : b) cin >> x;

        int mxA = 0, mxB = 0;

        for (int i = 0; i < n; i++) {
            int small = min(a[i], b[i]);
            int large = max(a[i], b[i]);

            mxA = max(mxA, small);
            mxB = max(mxB, large);
        }

        cout << 1LL * mxA * mxB << '\n';
    }

    return 0;
}
