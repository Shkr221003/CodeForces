#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, x, sum = 0;
        cin >> n;

        while (n--) {
            cin >> x;
            sum += x;
        }

        if (sum == 0) cout << 0;
        else if (sum < 0) cout << 1;
        else cout << sum - 1;

        cout << '\n';
    }

    return 0;
}
