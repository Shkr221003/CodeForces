#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<bool> vis(n + 1, false);

        for (int i = 0; i < 2 * n; i++) {
            int x;
            cin >> x;

            if (!vis[x]) {
                cout << x << " ";
                vis[x] = true;
            }
        }

        cout << '\n';
    }

    return 0;
}
