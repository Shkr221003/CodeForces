#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;
    vector<int> freq(n + 1, 0);
    vector<int> idx(n + 1, 0);
    
    for (int i = 0; i < n; i++) {
        int a;
        cin >> a;
        freq[a]++;
        idx[a] = i + 1; // Store 1-based index
    }
    
    int ans = -1;
    for (int i = 1; i <= n; i++) {
        if (freq[i] == 1) {
            ans = idx[i];
            break; // First unique number is the minimum one
        }
    }
    
    cout << ans << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
