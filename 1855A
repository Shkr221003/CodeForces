#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int cnt = 0;

        for (int i = 1; i <= n; i++) {
            int x;
            cin >> x;

            if (x == i)
                cnt++;
        }

        cout << (cnt + 1) / 2 << '\n';
    }

    return 0;
}
